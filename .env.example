# Contact form email (Resend)
# 1. Create account at https://resend.com
# 2. Create API key → paste below
# 3. Until you verify edanam.com in Resend, CONTACT_TO_EMAIL must be
#    the email you signed up with on Resend (e.g. ali4461@yahoo.com).
# 4. After verifying the domain, set:
#    CONTACT_TO_EMAIL=hello@edanam.com
#    CONTACT_FROM_EMAIL=Edanam <hello@edanam.com>

RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=your-resend-signup-email@example.com
CONTACT_FROM_EMAIL=Edanam <onboarding@resend.dev>
